import * as THREE from 'three';
import { ARButton } from 'ARButton';

// ========== ІНІЦІАЛІЗАЦІЯ ==========
const scene = new THREE.Scene();
scene.background = null;

const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.01, 100);

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(window.devicePixelRatio);
renderer.xr.enabled = true;

document.body.appendChild(renderer.domElement);

// ========== ОСВІТЛЕННЯ ==========
const ambientLight = new THREE.AmbientLight(0x404060, 0.7);
scene.add(ambientLight);

const directionalLight = new THREE.DirectionalLight(0xFFF5E0, 1.2);
directionalLight.position.set(5, 10, 3);
directionalLight.castShadow = true;
scene.add(directionalLight);

const fillLight = new THREE.PointLight(0xCCAA88, 0.5);
fillLight.position.set(0, -1, 0);
scene.add(fillLight);

// ========== СТВОРЕННЯ ПІРАМІД ==========
function createPyramid(radius, height, x, z, color, delay = 0) {
    const group = new THREE.Group();
    
    // Геометрія
    const geometry = new THREE.ConeGeometry(radius, height, 32);
    const material = new THREE.MeshStandardMaterial({ 
        color: 0xB5651D,
        roughness: 0.7,
        metalness: 0.1
    });
    
    const pyramid = new THREE.Mesh(geometry, material);
    pyramid.castShadow = true;
    pyramid.receiveShadow = true;
    pyramid.position.y = height / 2;
    group.add(pyramid);
    
    // Золота верхівка
    const goldGeometry = new THREE.ConeGeometry(radius * 0.07, height * 0.08, 16);
    const goldMaterial = new THREE.MeshStandardMaterial({
        color: 0xFFD700,
        metalness: 0.95,
        roughness: 0.2,
        emissive: 0x442200,
        emissiveIntensity: 0.3
    });
    
    const goldTop = new THREE.Mesh(goldGeometry, goldMaterial);
    goldTop.position.y = height;
    group.add(goldTop);
    
    // Анімація
    let time = 0;
    function animateGold() {
        time += 0.016;
        goldMaterial.emissiveIntensity = 0.3 + Math.sin(time * 3 + delay) * 0.15;
        requestAnimationFrame(animateGold);
    }
    animateGold();
    
    group.position.set(x, 0, z);
    return group;
}

// ========== ДОДАЄМО ПІРАМІДИ ==========
const scale = 0.008;

const pyramidsGroup = new THREE.Group();

// Хеопс (центр)
const khufu = createPyramid(230 * scale, 145 * scale, 0, 0, '#B5651D', 0);
pyramidsGroup.add(khufu);

// Хефрен (ліворуч)
const khafre = createPyramid(210 * scale, 135 * scale, -2.2, -1.5, '#B5651D', 1);
pyramidsGroup.add(khafre);

// Мікерін (праворуч)
const menkaure = createPyramid(100 * scale, 65 * scale, 2.0, -1.2, '#B5651D', 2);
pyramidsGroup.add(menkaure);

// Піщана основа
const groundPlane = new THREE.Mesh(
    new THREE.PlaneGeometry(8, 7),
    new THREE.MeshStandardMaterial({ color: 0xD2B48C, roughness: 0.9 })
);
groundPlane.rotation.x = -Math.PI / 2;
groundPlane.position.y = -0.05;
groundPlane.receiveShadow = true;
pyramidsGroup.add(groundPlane);

// Розміщуємо на відстані 1.5 метра перед камерою
pyramidsGroup.position.set(0, -0.2, -1.5);

scene.add(pyramidsGroup);

// ========== АНІМАЦІЯ ==========
function animate() {
    renderer.render(scene, camera);
}

// ========== КНОПКА AR ==========
// Спрощена версія без hit-test для кращої сумісності
const arButton = ARButton.createButton(renderer, {});

arButton.style.cssText = `
    position: fixed !important;
    bottom: 30px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    padding: 12px 24px !important;
    font-size: 16px !important;
    font-weight: bold !important;
    background: #FFD700 !important;
    color: #000 !important;
    border: none !important;
    border-radius: 40px !important;
    cursor: pointer !important;
    z-index: 200 !important;
    font-family: monospace !important;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3) !important;
`;

document.body.appendChild(arButton);

// ========== ОНОВЛЕННЯ СТАТУСУ ==========
function updateStatus(message, isOk = true) {
    const statusDiv = document.getElementById('status');
    if (statusDiv) {
        statusDiv.innerHTML = message;
        statusDiv.style.color = isOk ? '#0f0' : '#ff0';
    }
    console.log('[WebXR]', message);
}

// ========== ОБРОБНИКИ ПОДІЙ ==========
renderer.xr.addEventListener('sessionstart', () => {
    updateStatus('🎉 AR активовано! Піраміди перед вами');
    arButton.style.opacity = '0';
    arButton.style.pointerEvents = 'none';
    
    const instruction = document.getElementById('instruction');
    if (instruction) {
        instruction.innerHTML = '🏛️ Піраміди з\'явилися! Обійдіть їх навколо';
        instruction.style.background = 'rgba(0,100,0,0.8)';
    }
});

renderer.xr.addEventListener('sessionend', () => {
    updateStatus('⏸️ AR завершено');
    arButton.style.opacity = '1';
    arButton.style.pointerEvents = 'auto';
    
    const instruction = document.getElementById('instruction');
    if (instruction) {
        instruction.innerHTML = '📱 Наведіть камеру на підлогу<br>🏛️ Піраміди з\'являться перед вами';
        instruction.style.background = 'rgba(0,0,0,0.7)';
    }
});

// ========== ЗАПУСК ==========
updateStatus('✅ Готово | Натисніть кнопку AR');

renderer.setAnimationLoop(() => {
    animate();
});

window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});

console.log('🏛️ WebXR Піраміди Гізи завантажено');
