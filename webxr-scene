import * as THREE from 'three';
import { ARButton } from 'ARButton';

// ========== ІНІЦІАЛІЗАЦІЯ ==========
const scene = new THREE.Scene();
scene.background = null;

const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.01, 100);

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(window.devicePixelRatio);
renderer.xr.enabled = true;

document.body.appendChild(renderer.domElement);

// ========== ОСВІТЛЕННЯ ==========
const ambientLight = new THREE.AmbientLight(0x404060, 0.7);
scene.add(ambientLight);

const directionalLight = new THREE.DirectionalLight(0xFFF5E0, 1.2);
directionalLight.position.set(5, 10, 3);
directionalLight.castShadow = true;
scene.add(directionalLight);

const fillLight = new THREE.PointLight(0xCCAA88, 0.5);
fillLight.position.set(0, -1, 0);
scene.add(fillLight);

// ========== ДОПОМІЖНІ ФУНКЦІЇ ==========
function updateStatus(message, isOk = true) {
    const statusDiv = document.getElementById('status');
    if (statusDiv) {
        statusDiv.innerHTML = message;
        statusDiv.style.color = isOk ? '#0f0' : '#ff0';
    }
    console.log('[WebXR]', message);
}

// ========== СТВОРЕННЯ ПІРАМІД ==========
function createPyramid(radius, height, x, z, color, goldDelay = 0) {
    const group = new THREE.Group();
    
    // Цегляна текстура (програмно)
    const canvas = document.createElement('canvas');
    canvas.width = 512;
    canvas.height = 512;
    const ctx = canvas.getContext('2d');
    
    ctx.fillStyle = '#B5651D';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    ctx.strokeStyle = '#8B4513';
    ctx.lineWidth = 4;
    const brickW = 64;
    const brickH = 32;
    
    for (let y = 0; y < canvas.height; y += brickH) {
        const offset = (Math.floor(y / brickH) % 2) * brickW / 2;
        for (let xb = offset; xb < canvas.width; xb += brickW) {
            ctx.strokeRect(xb + 2, y + 2, brickW - 4, brickH - 4);
            ctx.fillStyle = '#C47E3A';
            ctx.fillRect(xb + 2, y + 2, brickW - 4, brickH - 4);
            ctx.fillStyle = '#B5651D';
        }
    }
    
    const brickTexture = new THREE.CanvasTexture(canvas);
    brickTexture.wrapS = THREE.RepeatWrapping;
    brickTexture.wrapT = THREE.RepeatWrapping;
    brickTexture.repeat.set(radius / 2, height / 3);
    
    const material = new THREE.MeshStandardMaterial({
        map: brickTexture,
        roughness: 0.7,
        metalness: 0.1
    });
    
    const geometry = new THREE.ConeGeometry(radius, height, 32);
    const pyramid = new THREE.Mesh(geometry, material);
    pyramid.castShadow = true;
    pyramid.receiveShadow = true;
    pyramid.position.y = height / 2;
    group.add(pyramid);
    
    // Золота верхівка
    const goldGeometry = new THREE.ConeGeometry(radius * 0.07, height * 0.08, 16);
    const goldMaterial = new THREE.MeshStandardMaterial({
        color: 0xFFD700,
        metalness: 0.95,
        roughness: 0.2,
        emissiveIntensity: 0.3
    });
    
    const goldTop = new THREE.Mesh(goldGeometry, goldMaterial);
    goldTop.position.y = height;
    group.add(goldTop);
    
    // Анімація верхівки
    let time = 0;
    function animateGold() {
        time += 0.016;
        const intensity = 0.3 + Math.sin(time * 3 + goldDelay) * 0.15;
        goldMaterial.emissiveIntensity = intensity;
        goldMaterial.color.setHSL(0.12 + Math.sin(time * 1.5 + goldDelay) * 0.03, 1.0, 0.55);
        requestAnimationFrame(animateGold);
    }
    animateGold();
    
    group.position.set(x, 0, z);
    return group;
}

// ========== ДОДАЄМО ПІРАМІДИ (через 1 метр перед камерою) ==========
// Це забезпечить їх появу одразу після запуску AR

const scale = 0.008;

// Група для всіх пірамід
const pyramidsGroup = new THREE.Group();

const khufu = createPyramid(230 * scale, 145 * scale, 0, 0, '#B5651D', 0);
pyramidsGroup.add(khufu);

const khafre = createPyramid(210 * scale, 135 * scale, -2.2, -1.5, '#B5651D', 1);
pyramidsGroup.add(khafre);

const menkaure = createPyramid(100 * scale, 65 * scale, 2.0, -1.2, '#B5651D', 2);
pyramidsGroup.add(menkaure);

// Піщана основа
const groundPlane = new THREE.Mesh(
    new THREE.PlaneGeometry(8, 7),
    new THREE.MeshStandardMaterial({ color: 0xD2B48C, roughness: 0.9 })
);
groundPlane.rotation.x = -Math.PI / 2;
groundPlane.position.y = -0.05;
groundPlane.receiveShadow = true;
pyramidsGroup.add(groundPlane);

scene.add(pyramidsGroup);

// Розміщуємо піраміди на відстані 1.5 метра перед камерою
// WebXR використовує camera.position для визначення місця
pyramidsGroup.position.set(0, -0.2, -1.5);

// ========== АНІМАЦІЯ ==========
let time = 0;

function animate() {
    time += 0.016;
    
    // Повільне обертання всієї групи для кращого огляду
    // pyramidsGroup.rotation.y = Math.sin(time * 0.1) * 0.2;
    
    renderer.render(scene, camera);
}

// ========== КНОПКА AR ==========
const arButton = ARButton.createButton(renderer, {
    requiredFeatures: ['hit-test'],
    optionalFeatures: ['dom-overlay'],
    domOverlay: { root: document.body }
});
arButton.style.cssText = `
    position: fixed !important;
    bottom: 30px !important;
    left: 50% !important;
    transform: translateX(-50%) !important;
    padding: 12px 24px !important;
    font-size: 16px !important;
    font-weight: bold !important;
    background: #FFD700 !important;
    color: #000 !important;
    border: none !important;
    border-radius: 40px !important;
    cursor: pointer !important;
    z-index: 200 !important;
    font-family: monospace !important;
`;
document.body.appendChild(arButton);

// ========== ОБРОБНИКИ ПОДІЙ ==========
renderer.xr.addEventListener('sessionstart', () => {
    updateStatus('🎉 AR активовано! Піраміди перед вами');
    // Приховуємо кнопку після запуску
    arButton.style.opacity = '0';
    arButton.style.pointerEvents = 'none';
});

renderer.xr.addEventListener('sessionend', () => {
    updateStatus('⏸️ AR завершено');
    arButton.style.opacity = '1';
    arButton.style.pointerEvents = 'auto';
});

// ========== ЗАПУСК ==========
updateStatus('✅ Готово | Натисніть кнопку AR');

renderer.setAnimationLoop(() => {
    animate();
});

window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
});
